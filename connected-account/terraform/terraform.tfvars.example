# Auth0 テナントドメイン
auth0_domain = "dev-xxxxx.us.auth0.com"

# Terraform provider 用 M2M アプリの認証情報
# (setup.sh が自動設定するため、通常は手動設定不要)
auth0_provider_client_id     = ""
auth0_provider_client_secret = ""

# テストユーザー
test_user_email    = "test@example.com"
test_user_password = ""

# GCP OAuth2 クライアント
# (Google Cloud Console で作成したクライアントの認証情報)
google_client_id     = ""
google_client_secret = ""

# Cloudflare Workers URL (初回は空、デプロイ後に設定)
workers_url = ""
